# Copie para .env e preencha. O .env não vai para o Git.
# Também dá para configurar tudo pela tela: Configurações > Inteligência artificial
# (o que for salvo lá vale mais que o .env e fica em data/ia.json).

# Provedor: openai | anthropic | compativel (qualquer API /chat/completions: Azure, OpenRouter, Groq, Ollama...)
LLM_PROVEDOR=openai
LLM_MODELO=gpt-5.5
LLM_API_KEY=
# Só para "compativel" (ou para trocar o endereço da OpenAI/Anthropic):
LLM_BASE_URL=

# Nomes antigos continuam valendo:
# OPENAI_API_KEY=
# OPENAI_MODEL=
